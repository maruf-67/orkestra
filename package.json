{
  "name": "orkestra",
  "version": "1.0.10",
  "description": "A cross-platform development workspace manager",
  "type": "module",
  "bin": {
    "orkestra": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "check": "bun run typecheck && bun run test && bun run test:coverage && bun run build"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "keywords": [
    "cli",
    "development",
    "workspace",
    "proxy",
    "caddy",
    "local-domains",
    "https",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "execa": "^9.6.1",
    "get-port": "^7.2.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
